{
  "name": "catalogo-politicas-site",
  "version": "0.1.0-poc",
  "private": true,
  "type": "module",
  "description": "PoC Eleventy 3 do site do Catálogo de Políticas Públicas (FRM/IESP-UERJ)",
  "scripts": {
    "dev": "npx @11ty/eleventy --serve --quiet",
    "build": "npx @11ty/eleventy && npm run css && npm run search",
    "css": "npx tailwindcss -i src/assets/css/tailwind.css -o _site/assets/css/styles.css --minify",
    "css:dev": "npx tailwindcss -i src/assets/css/tailwind.css -o _site/assets/css/styles.css --watch",
    "search": "npx pagefind --site _site",
    "test": "node --test tests/",
    "audit": "npm audit --audit-level=high",
    "clean": "rm -rf _site pagefind"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-rss": "^2.0.2",
    "@axe-core/cli": "^4.11.3",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-serif": "^5.2.7",
    "@lhci/cli": "^0.15.1",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/typography": "^0.5.15",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.20",
    "d3": "^7.9.0",
    "mapshaper": "^0.7.8",
    "pagefind": "^1.1.1",
    "postcss": "^8.4.49",
    "puppeteer": "^24.42.0",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=20"
  }
}
