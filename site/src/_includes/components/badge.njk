{# Componente: badge (E.5 §2.7).
   Espera variáveis globais:
     badgeValor (string ou number, obrigatório)
     badgeSufixo (string, opcional — ex.: "%")
     badgeLabel (string, opcional — para aria-label)
     badgeVariant (string, opcional — alta|media|baixa|info; auto-deriva se valor é %)

   Uso:
     {% set badgeValor = 92 %}
     {% set badgeSufixo = "%" %}
     {% set badgeLabel = "Completude dos metadados" %}
     {% include "components/badge.njk" %}

   Auto-deriva variante de % numérico: ≥90 alta, 70-89 media, <70 baixa. #}

{% set _bClasses = "badge" %}
{% if badgeVariant %}
  {% set _bClasses = _bClasses + " badge--" + badgeVariant %}
{% elif badgeSufixo == "%" and badgeValor is number %}
  {% if badgeValor >= 90 %}
    {% set _bClasses = _bClasses + " badge--alta" %}
  {% elif badgeValor >= 70 %}
    {% set _bClasses = _bClasses + " badge--media" %}
  {% else %}
    {% set _bClasses = _bClasses + " badge--baixa" %}
  {% endif %}
{% else %}
  {% set _bClasses = _bClasses + " badge--info" %}
{% endif %}

<span class="{{ _bClasses }}"
      {% if badgeLabel %}aria-label="{{ badgeLabel }}: {{ badgeValor }}{{ badgeSufixo or '' }}"{% endif %}>
  {{ badgeValor }}{{ badgeSufixo or '' }}
</span>