{# Mapa compartilhado entre a página inicial e a consulta por contagens. #}
<style>
  .mapa-interativo { position: relative; min-width: 0; }
  .mapa-superficie { overflow: hidden; }
  .mapa-desenho { display: block; width: 100%; height: auto; max-height: 680px; }
  .mapa-legenda-selecao { min-height: 3rem; padding-top: .5rem; font-size: 1rem; color: var(--color-muted); }
  .mapa-tooltip { position: absolute; pointer-events: none; max-width: min(240px, 90%); background: var(--color-text); color: white; padding: .625rem .875rem; border-radius: .25rem; font-size: .875rem; line-height: 1.4; z-index: 2; }
  .mapa-tooltip strong { display: block; }
  .mapa-desenho path:focus-visible { outline: none; stroke: var(--color-primary-dark); stroke-width: 2.5; }
</style>
<div class="mapa-interativo">
  <div id="mapa-container" class="mapa-superficie" role="group" aria-labelledby="mapa-h" aria-describedby="mapa-desc">
    <h2 id="mapa-h" class="sr-only">Mapa interativo do Brasil</h2>
    <p id="mapa-desc" class="sr-only">
      Selecione uma das 27 unidades da federação para conhecer suas experiências.
      Use Tab para navegar e Enter ou Espaço para abrir a página.
      Os mesmos destinos estão disponíveis na lista de estados.
    </p>
    <svg id="mapa-svg" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid meet"
         class="mapa-desenho" data-mapa-modo="{{ 'navegacao' if mapaNaHome else 'contagens' }}">
      <text x="300" y="300" text-anchor="middle" fill="#625F70" font-size="16">Carregando mapa…</text>
    </svg>
  </div>
  <div id="mapa-tooltip" aria-hidden="true" role="tooltip" class="mapa-tooltip hidden"></div>
  <p id="mapa-selecao" class="mapa-legenda-selecao">Selecione um estado para conhecer as experiências.</p>
  <div id="mapa-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
</div>
<noscript>
  <p class="text-note">Consulte as experiências pelos nomes dos estados na lista abaixo.</p>
</noscript>
