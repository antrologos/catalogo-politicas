{#- As 16 instituições mantêm nomes, links, logos e ordem do cadastro.
   Controle de espaço preserva o bloco HTML quando incluído em Markdown. -#}
{%- set _titulo = painelTitulo or "Instituições da Rede EJA e Inclusão Produtiva" -%}
<section class="painel-rede not-prose" aria-labelledby="painel-rede-h">
<h2 id="painel-rede-h">{{ _titulo }}</h2>
<ul class="rede-logos">
{%- for inst in equipe.redeEja %}
<li><a href="{{ inst.url }}" rel="external" title="{{ inst.nome }}" class="rede-logo-link{{ ' rede-logo-link--paired' if inst.logos | length > 1 else '' }}">
{%- for arq in inst.logos -%}
{%- if not loop.first %}<span aria-hidden="true" class="rede-logo-divider"></span>{% endif -%}
<img src="/assets/img/rede/{{ arq }}" alt="{{ inst.nome if loop.first else '' }}" loading="lazy" decoding="async">
{%- endfor -%}
</a></li>
{%- endfor %}
</ul>
<p class="rede-panel-link"><a href="{{ equipe.redeUrl }}" rel="external">Conheça a Rede EJA e Inclusão Produtiva ↗</a></p>
</section>