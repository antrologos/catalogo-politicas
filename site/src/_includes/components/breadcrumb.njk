{# Componente: breadcrumb (E.5).
   Espera variável global `crumbs` (array de { texto, href? }).
   Último item sem href = aria-current="page".

   Uso:
     {% set crumbs = [
       { texto: "Início", href: "/" },
       { texto: "Buscar", href: "/buscar/" },
       { texto: "Resultado atual" }
     ] %}
     {% include "components/breadcrumb.njk" %}

   A11y: <nav aria-label> + <ol>. #}

{% if crumbs and crumbs | length %}
<nav aria-label="Caminho da navegação">
  <ol class="breadcrumb list-none p-0">
    {% for item in crumbs %}
      <li>
        {% if item.href and not loop.last %}
          <a href="{{ item.href }}">{{ item.texto }}</a>
        {% else %}
          <span aria-current="page">{{ item.texto }}</span>
        {% endif %}
      </li>
    {% endfor %}
  </ol>
</nav>
{% endif %}