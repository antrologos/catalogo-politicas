{# Marca integral da Rede e acessos principais visíveis, inclusive sem JavaScript. #}
{% set urlAtual = page.url or "/" %}
<header class="site-header" role="banner">
  <div class="container-prose site-header-inner">
    <a href="/" class="site-brand">
      <img src="/assets/img/rede/rede-eja-logo.svg" alt="Rede EJA e Inclusão Produtiva" width="477" height="100" class="site-brand-logo" decoding="async">
      <span class="site-brand-name">{{ site.shortTitle }}</span>
    </a>
    <nav id="nav-principal" class="site-nav" aria-label="Principal">
      <ul>
        {% for item in site.navegacao %}
          {% set ativo = (item.href == "/" and urlAtual == "/") or (item.href != "/" and (urlAtual | startsWith(item.href))) %}
          <li><a href="{{ item.href }}"{% if ativo %} aria-current="page"{% endif %}>{{ item.texto }}</a></li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>