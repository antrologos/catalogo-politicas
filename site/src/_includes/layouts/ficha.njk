---
layout: layouts/base.njk
---
{% set crumbs = [
  { texto: "Início", href: "/" },
  { texto: ("Políticas " + p.uf), href: ("/buscar/?uf=" + p.uf) },
  { texto: p.nome_programa }
] %}
{% include "components/breadcrumb.njk" %}

<article data-pagefind-body
         data-pagefind-meta="uf:{{ p.uf }}, ano:{{ p.ano_criacao or '—' }}"
         class="prose prose-neutral max-w-none">

  {# Filtros Pagefind: cada um deve ser um elemento separado com data-pagefind-filter
     como CHAVE (não chave:valor numa única string — isso quebra a UI).
     Escondidos visualmente; Pagefind lê apenas o atributo + textContent. #}
  <span data-pagefind-filter="UF" class="visually-hidden">{{ p.uf }}</span>
  <span data-pagefind-filter="Situação" class="visually-hidden">{{ p.situacao_atual or 'Sem informação' }}</span>
  <span data-pagefind-filter="Tipo" class="visually-hidden">{{ p.tipo_politica or 'Sem classificação' }}</span>
  {% if p.modalidade_oferta %}
    <span data-pagefind-filter="Modalidade" class="visually-hidden">{{ p.modalidade_oferta }}</span>
  {% endif %}
  <span data-pagefind-filter="Snapshot" class="visually-hidden">{% if p.fonte_arquivo_path %}Disponível{% else %}Indisponível{% endif %}</span>


  <header class="border-b border-neutral-200 pb-lg mb-xl">
    <h1>{{ p.nome_programa }}</h1>
    <p class="text-sm text-neutral-700 mt-sm flex flex-wrap gap-md items-center">
      {% include "components/tag-status.njk" %}
      {% if p.isFederal %}
        <span class="tag tag--federal">Federal</span>
      {% else %}
        <span class="tag tag--estadual">{{ p.uf }}</span>
      {% endif %}
      <span aria-label="Identificador universal">ID: <code>{{ p.id_universal }}</code></span>
      {% if p.revisado_em_br %}
      <span>Revisado em <time datetime="{{ p.data_revisao }}">{{ p.revisado_em_br }}</time></span>
      {% endif %}
      {% if p.completude_pct %}
        {% set badgeValor = p.completude_pct %}
        {% set badgeSufixo = "%" %}
        {% set badgeLabel = "Completude dos metadados" %}
        {% set badgeVariant = "" %}
        {% include "components/badge.njk" %}
      {% endif %}
    </p>
  </header>

  {# === Conteúdo das abas (capturado via {% set %}) === #}
  {% set abaResumo %}
    {% if p.descricao_simples %}
      <h3>Em linguagem simples</h3>
      <p>{{ p.descricao_simples }}</p>
    {% endif %}
    {% if p.resumo %}
      <h3>Resumo</h3>
      <p>{{ p.resumo }}</p>
    {% endif %}
    {% if p.apresentacao and p.apresentacao != p.descricao_tecnica %}
      <h3>Apresentação</h3>
      <p>{{ p.apresentacao }}</p>
    {% endif %}
    {% if not p.descricao_simples and not p.resumo and not p.apresentacao %}
      <p class="text-neutral-700">Sem descrição cadastrada nesta versão da ficha.</p>
    {% endif %}
  {% endset %}

  {% set abaDetalhes %}
    <h3 class="sr-only">Detalhes institucionais</h3>
    <dl class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-x-md gap-y-sm">
      <dt class="font-semibold text-neutral-700">Tipo de política</dt>
      <dd>{{ p.tipo_politica or '—' }}</dd>

      {% if p.esfera_formulacao %}
        <dt class="font-semibold text-neutral-700">Esfera de formulação</dt>
        <dd>{{ p.esfera_formulacao }}</dd>
      {% endif %}
      {% if p.esfera_execucao %}
        <dt class="font-semibold text-neutral-700">Esfera de execução</dt>
        <dd>{{ p.esfera_execucao }}</dd>
      {% endif %}
      {% if p.abrangencia_territorial %}
        <dt class="font-semibold text-neutral-700">Abrangência territorial</dt>
        <dd>{{ p.abrangencia_territorial }}</dd>
      {% endif %}
      {% if p.tipo_oferta %}
        <dt class="font-semibold text-neutral-700">Tipo de oferta</dt>
        <dd>{{ p.tipo_oferta }}</dd>
      {% endif %}
      {% if p.modalidade_oferta %}
        <dt class="font-semibold text-neutral-700">Modalidade da oferta</dt>
        <dd>{{ p.modalidade_oferta }}</dd>
      {% endif %}
      {% if p.arranjo_logistico %}
        <dt class="font-semibold text-neutral-700">Arranjo logístico</dt>
        <dd>{{ p.arranjo_logistico }}</dd>
      {% endif %}
      {% if p.carga_horaria %}
        <dt class="font-semibold text-neutral-700">Carga horária</dt>
        <dd>{{ p.carga_horaria }}</dd>
      {% endif %}
      {% if p.ano_criacao %}
        <dt class="font-semibold text-neutral-700">Ano de criação</dt>
        <dd>{{ p.ano_criacao }}</dd>
      {% endif %}
      {% if p.fonte_financiamento %}
        <dt class="font-semibold text-neutral-700">Fonte de financiamento</dt>
        <dd>{{ p.fonte_financiamento }}</dd>
      {% endif %}
      {% if p.transferencia_recursos %}
        <dt class="font-semibold text-neutral-700">Transferência de recursos</dt>
        <dd>{{ p.transferencia_recursos }}</dd>
      {% endif %}
      {% if p.continuidade_governos %}
        <dt class="font-semibold text-neutral-700">Continuidade entre governos</dt>
        <dd>{{ p.continuidade_governos }}</dd>
      {% endif %}
      {% if p.orgaos_lista and p.orgaos_lista | length %}
        <dt class="font-semibold text-neutral-700">Órgãos responsáveis</dt>
        <dd>
          <ul class="list-disc pl-md">
            {% for o in p.orgaos_lista %}<li>{{ o }}</li>{% endfor %}
          </ul>
        </dd>
      {% endif %}
      {% if p.integra_lista and p.integra_lista | length %}
        <dt class="font-semibold text-neutral-700">Integra com</dt>
        <dd>
          <ul class="list-disc pl-md">
            {% for i in p.integra_lista %}<li>{{ i }}</li>{% endfor %}
          </ul>
        </dd>
      {% endif %}
    </dl>
  {% endset %}

  {% set abaBaseLegal %}
    <h3 class="sr-only">Base legal</h3>
    {% if p.base_legal %}
      <p class="whitespace-pre-line">{{ p.base_legal }}</p>
    {% else %}
      <p class="text-neutral-700">Base legal não cadastrada nesta versão da ficha.</p>
    {% endif %}
  {% endset %}

  {% set abaDocumentos %}
    <h3 class="sr-only">Documentos e fonte oficial</h3>
    {% if p.fonte_url %}
      <p>
        <strong>Fonte oficial:</strong>
        <a href="{{ p.fonte_url }}" rel="external nofollow noopener" target="_blank">
          Acessar no portal oficial ↗
        </a>
        <span class="text-xs text-neutral-700">(abre em nova aba)</span>
      </p>
    {% endif %}

    {% if p.fonte_arquivo_path %}
      <p class="mt-md">
        <strong>Snapshot capturado:</strong>
        {% if p.fonte_data_acesso_br %}
          em <time datetime="{{ p.fonte_data_acesso }}">{{ p.fonte_data_acesso_br }}</time>
        {% endif %}
        {% if p.fonte_extensao %}
          (formato: {{ p.fonte_extensao | upper }})
        {% endif %}
      </p>
      {% if p.fonte_sha256 %}
        <p class="text-xs text-neutral-700 mt-2xs">
          SHA-256: <code>{{ p.fonte_sha256 | truncate(16, true, '…') }}</code>
        </p>
      {% endif %}
    {% else %}
      <p class="mt-md text-neutral-700">
        Snapshot integral ainda não capturado. Veja
        <a href="/sobre/cobertura/">cobertura e limites</a>
        para detalhes sobre URLs com falha persistente (gov.br WAF, planalto timeout).
      </p>
    {% endif %}

    {% if p.atribuicao %}
      <p class="mt-md text-sm text-neutral-700">
        <strong>Atribuição:</strong> {{ p.atribuicao }}
      </p>
    {% endif %}
    {% if p.licenca_inferida %}
      <p class="text-sm text-neutral-700">
        <strong>Licença da fonte:</strong> {{ p.licenca_inferida }}
      </p>
    {% endif %}
  {% endset %}

  {% set abaCitacao %}
    {% include "components/citation-box.njk" %}
  {% endset %}

  {% set tabsList = [
    { id: "resumo", label: "Resumo", panel: abaResumo },
    { id: "detalhes", label: "Detalhes", panel: abaDetalhes },
    { id: "base-legal", label: "Base legal", panel: abaBaseLegal },
    { id: "documentos", label: "Documentos", panel: abaDocumentos },
    { id: "citacao", label: "Como citar", panel: abaCitacao }
  ] %}

  {% set tabsLabel = "Seções da ficha" %}
  {% set tabsId = "tabs-" + p.slug %}
  {% include "components/tabs.njk" %}

  <footer class="mt-2xl pt-md border-t border-neutral-200 text-sm text-neutral-700">
    <h2 class="text-base mt-0">Proveniência</h2>
    <dl class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-x-md gap-y-2xs mt-sm">
      {% if p.revisado_por %}
        <dt class="font-semibold">Revisado por</dt><dd>{{ p.revisado_por }}</dd>
      {% endif %}
      {% if p.proxima_revisao_br %}
        <dt class="font-semibold">Próxima revisão prevista</dt>
        <dd><time datetime="{{ p.proxima_revisao_prevista }}">{{ p.proxima_revisao_br }}</time></dd>
      {% endif %}
      <dt class="font-semibold">Versão do catálogo</dt><dd>{{ p.data_versao_catalogo }}</dd>
      <dt class="font-semibold">ID interno</dt><dd><code>{{ p.id_interno }}</code></dd>
    </dl>

    <p class="mt-md">
      Encontrou erro ou tem sugestão?
      <a href="https://github.com/antrologos/catalogo-politicas/issues/new?title=Correção:+{{ p.nome_programa | urlencode }}"
         rel="noopener" target="_blank">
        Abrir issue no GitHub ↗
      </a>
    </p>
  </footer>
</article>