---
layout: layouts/base.njk
---
<article data-pagefind-body
         data-pagefind-meta="uf:{{ p.uf }}"
         data-pagefind-filter="uf:{{ p.uf }}, situacao:{{ p.situacao_atual }}, tipo:{{ p.tipo_politica }}"
         class="prose prose-neutral max-w-none">

  <nav aria-label="Navegação contextual" class="text-sm mb-md">
    <a href="{{ '/' | url }}">Início</a> ›
    <a href="{{ '/buscar/?uf=' + p.uf | url }}">Políticas {{ p.uf }}</a> ›
    <span aria-current="page">{{ p.nome_programa }}</span>
  </nav>

  <header class="border-b border-neutral-200 pb-lg mb-xl">
    <h1>{{ p.nome_programa }}</h1>
    <p class="text-sm text-neutral-700 mt-sm flex flex-wrap gap-md items-center">
      {% include "components/tag-status.njk" %}
      <span aria-label="Identificador universal">ID: <code>{{ p.id_universal }}</code></span>
      <span>UF: <strong>{{ p.uf }}</strong></span>
      {% if p.revisado_em_br %}
      <span>Revisado em <time datetime="{{ p.data_revisao }}">{{ p.revisado_em_br }}</time></span>
      {% endif %}
      <span class="bg-info/10 text-info-dark px-sm py-2xs rounded text-xs"
            title="Completude dos metadados">
        Completude: {{ p.completude_pct }}%
      </span>
    </p>
  </header>

  {% if p.resumo %}
  <section aria-labelledby="resumo-h">
    <h2 id="resumo-h">Resumo</h2>
    <p>{{ p.resumo }}</p>
  </section>
  {% endif %}

  <section aria-labelledby="ident-h">
    <h2 id="ident-h">Identificação</h2>
    <dl class="grid grid-cols-1 sm:grid-cols-[200px_1fr] gap-x-md gap-y-sm">
      <dt class="font-semibold text-neutral-700">Tipo de política</dt>
      <dd>{{ p.tipo_politica }}</dd>

      {% if p.esfera_formulacao %}
      <dt class="font-semibold text-neutral-700">Esfera de formulação</dt>
      <dd>{{ p.esfera_formulacao }}</dd>
      {% endif %}

      {% if p.esfera_execucao %}
      <dt class="font-semibold text-neutral-700">Esfera de execução</dt>
      <dd>{{ p.esfera_execucao }}</dd>
      {% endif %}

      {% if p.abrangencia_territorial %}
      <dt class="font-semibold text-neutral-700">Abrangência territorial</dt>
      <dd>{{ p.abrangencia_territorial }}</dd>
      {% endif %}

      {% if p.modalidade_oferta %}
      <dt class="font-semibold text-neutral-700">Modalidade de oferta</dt>
      <dd>{{ p.modalidade_oferta }}</dd>
      {% endif %}

      {% if p.ano_criacao %}
      <dt class="font-semibold text-neutral-700">Ano de criação</dt>
      <dd>{{ p.ano_criacao }}</dd>
      {% endif %}
    </dl>
  </section>

  {% if p.base_legal %}
  <section aria-labelledby="legal-h">
    <h2 id="legal-h">Base legal</h2>
    <p>{{ p.base_legal }}</p>
  </section>
  {% endif %}

  {% if p.apresentacao %}
  <section aria-labelledby="apres-h">
    <h2 id="apres-h">Apresentação detalhada</h2>
    <p>{{ p.apresentacao }}</p>
  </section>
  {% endif %}

  {% if p.fonte_url %}
  <section aria-labelledby="fonte-h">
    <h2 id="fonte-h">Documento oficial</h2>
    <ul class="space-y-sm">
      <li>
        <a href="{{ p.fonte_url }}" rel="external nofollow"
           class="inline-flex items-center gap-2xs">
          🔗 Ver no portal oficial
        </a>
      </li>
      {% if p.fonte_arquivo_path %}
      <li>
        <span class="text-neutral-700 text-sm">
          Snapshot capturado em
          {% if p.fonte_data_acesso %}<time datetime="{{ p.fonte_data_acesso }}">{{ p.fonte_data_acesso | dataBR }}</time>{% endif %}
          (SHA-256: <code class="text-xs">{{ p.fonte_sha256 | truncate(12, true, '…') }}</code>)
        </span>
      </li>
      {% endif %}
    </ul>
  </section>
  {% endif %}

  <section aria-labelledby="cita-h" class="mt-2xl bg-neutral-100 p-lg rounded">
    <h2 id="cita-h">Como citar</h2>
    <details class="mt-sm">
      <summary class="cursor-pointer font-semibold">ABNT</summary>
      <pre class="mt-sm whitespace-pre-wrap text-sm bg-white p-md rounded border border-neutral-200"><code>{{ p | citacaoAbnt }}</code></pre>
    </details>
    <details class="mt-sm">
      <summary class="cursor-pointer font-semibold">BibTeX</summary>
      <pre class="mt-sm whitespace-pre-wrap text-sm bg-white p-md rounded border border-neutral-200"><code>{{ p | citacaoBibtex }}</code></pre>
    </details>
  </section>

</article>
