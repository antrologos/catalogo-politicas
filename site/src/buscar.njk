---
layout: layouts/base.njk
title: "Buscar políticas"
description: "Busca textual e filtros facetados nas 439 políticas catalogadas."
permalink: /buscar/
---
{% set crumbs = [
  { texto: "Início", href: "/" },
  { texto: "Buscar" }
] %}
{% include "components/breadcrumb.njk" %}

<section aria-labelledby="busca-h">
  <h1 id="busca-h">Buscar políticas</h1>
  <p class="text-neutral-700">
    Busque por nome do programa, base legal, órgão responsável ou termos
    do resumo. Use os filtros para restringir por UF, situação, tipo,
    modalidade ou disponibilidade de snapshot integral.
  </p>

  <p class="text-sm text-neutral-700 mt-sm">
    <strong>{{ policies | length }}</strong> políticas no catálogo
    (1ª onda — 9 UFs + Federal).
    <kbd class="bg-neutral-100 border border-neutral-200 px-2xs rounded text-xs">/</kbd>
    foca a caixa de busca.
  </p>
</section>

{# Pagefind UI será montada em #search; estilizada via CSS próprio + tokens nossos #}
<div id="search" class="mt-xl"></div>

<noscript>
  <div role="alert" class="mt-xl bg-warning/15 text-warning-dark p-md rounded">
    <p>A busca facetada requer JavaScript. Você pode navegar pela
    <a href="/">página inicial</a> ou consultar o
    <a href="https://github.com/antrologos/catalogo-politicas">repositório no GitHub</a>
    para baixar os dados em JSON.</p>
  </div>
</noscript>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css">
<script src="/pagefind/pagefind-ui.js" defer></script>
<script>
  (function () {
    "use strict";
    if (typeof window === "undefined") return;

    let pagefindUI = null;

    function init() {
      if (typeof PagefindUI === "undefined") {
        // Pagefind UI ainda não carregou; tenta de novo em 100ms
        setTimeout(init, 100);
        return;
      }
      pagefindUI = new PagefindUI({
        element: "#search",
        bundlePath: "/catalogo-politicas/pagefind/",
        baseUrl: "/catalogo-politicas/",
        showSubResults: true,
        showImages: false,
        pageSize: 10,
        resetStyles: true,
        autofocus: false,
        translations: {
          placeholder: "Digite nome, sigla, base legal, órgão...",
          clear_search: "Limpar busca",
          load_more: "Mostrar mais resultados",
          search_label: "Buscar políticas no catálogo",
          filters_label: "Filtros",
          zero_results: "Nenhuma política encontrada para [SEARCH_TERM]. Limpe a busca ou tente outros termos.",
          many_results: "[COUNT] políticas correspondem a [SEARCH_TERM]",
          one_result: "1 política corresponde a [SEARCH_TERM]",
          alt_search: "Nenhum resultado para [SEARCH_TERM]. Mostrando resultados para [DIFFERENT_TERM] em vez disso.",
          search_suggestion: "Nenhum resultado para [SEARCH_TERM]. Tente uma destas buscas:",
          searching: "Buscando [SEARCH_TERM]..."
        }
      });

      // Lê ?q= da URL e dispara busca automaticamente.
      // Pagefind UI default não faz isso sozinho — precisa de glue manual.
      const params = new URLSearchParams(window.location.search);
      const initialQuery = params.get("q");
      if (initialQuery) {
        // Pagefind UI v1.x: triggerSearch(query) preenche input + executa
        if (typeof pagefindUI.triggerSearch === "function") {
          pagefindUI.triggerSearch(initialQuery);
        } else {
          // Fallback: setar valor no input + disparar evento input
          waitForInput(initialQuery);
        }
      }
    }

    function waitForInput(value, attempts) {
      attempts = attempts || 0;
      if (attempts > 30) return; // timeout 3s
      const input = document.querySelector("#search input[type='text']");
      if (!input) {
        setTimeout(() => waitForInput(value, attempts + 1), 100);
        return;
      }
      input.value = value;
      input.dispatchEvent(new Event("input", { bubbles: true }));
      input.focus();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    // Atalho de teclado: tecla "/" foca caixa de busca
    document.addEventListener("keydown", (e) => {
      if (e.key === "/" && document.activeElement && !["INPUT", "TEXTAREA"].includes(document.activeElement.tagName)) {
        const input = document.querySelector("#search input[type='text']");
        if (input) {
          e.preventDefault();
          input.focus();
        }
      }
    });
  })();
</script>

<style>
  /* Customização visual do Pagefind UI para combinar com paleta gov.uk-inspired.
     resetStyles: true no init faz Pagefind aplicar apenas estilos básicos. */
  #search {
    --pagefind-ui-primary: #0066cc;
    --pagefind-ui-text: #0b0c0c;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e2e8f0;
    --pagefind-ui-tag: #f5f5f5;
    --pagefind-ui-border-width: 2px;
    --pagefind-ui-border-radius: 4px;
    --pagefind-ui-font: "Open Sans", system-ui, sans-serif;
  }
  #search .pagefind-ui__form {
    margin-bottom: 1.5rem;
  }
  #search .pagefind-ui__search-input {
    border: 2px solid #757575;
    padding: 0.75rem;
    border-radius: 4px;
    width: 100%;
  }
  #search .pagefind-ui__search-input:focus-visible {
    outline: 3px solid #ffdd00;
    outline-offset: 2px;
    box-shadow: inset 0 0 0 2px #0b0c0c;
  }
  #search .pagefind-ui__filter-panel {
    background: #f5f5f5;
    padding: 1rem;
    border-radius: 4px;
    margin-bottom: 1rem;
  }
  #search .pagefind-ui__filter-name {
    font-weight: 600;
    color: #0b0c0c;
  }
  #search .pagefind-ui__filter-checkbox:focus-visible {
    outline: 3px solid #ffdd00;
    outline-offset: 2px;
  }
  #search .pagefind-ui__result {
    border-bottom: 1px solid #e2e8f0;
    padding-block: 1rem;
  }
  #search .pagefind-ui__result-link {
    color: #0066cc;
    text-decoration: underline;
    font-weight: 600;
  }
  #search .pagefind-ui__result-link:focus-visible {
    outline: 3px solid #ffdd00;
    outline-offset: 2px;
  }
  #search .pagefind-ui__result-tags .pagefind-ui__result-tag {
    background: #f5f5f5;
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: #475569;
  }
  #search .pagefind-ui__button {
    min-height: 44px;
    padding-inline: 1rem;
    background: #0066cc;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
  }
  #search .pagefind-ui__button:hover {
    background: #004c99;
  }
  #search button:focus-visible {
    outline: 3px solid #ffdd00;
    outline-offset: 2px;
  }
</style>