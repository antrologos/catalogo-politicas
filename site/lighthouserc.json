{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "url": [
        "http://localhost/",
        "http://localhost/buscar/",
        "http://localhost/sobre/",
        "http://localhost/sobre/privacidade/",
        "http://localhost/explorar/",
        "http://localhost/mapa/",
        "http://localhost/comparacao/",
        "http://localhost/uf/df/",
        "http://localhost/politica/programa-nacional-de-acesso-ao-ensino-tecnico-e-emprego-pronatec-br/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "uses-http2",
          "redirects-http",
          "is-on-https",
          "uses-long-cache-ttl",
          "csp-xss",
          "errors-in-console"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
