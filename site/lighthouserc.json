{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8090/catalogo-politicas/",
        "http://localhost:8090/catalogo-politicas/buscar/",
        "http://localhost:8090/catalogo-politicas/sobre/",
        "http://localhost:8090/catalogo-politicas/sobre/privacidade/",
        "http://localhost:8090/catalogo-politicas/explorar/",
        "http://localhost:8090/catalogo-politicas/mapa/",
        "http://localhost:8090/catalogo-politicas/comparacao/",
        "http://localhost:8090/catalogo-politicas/uf/df/",
        "http://localhost:8090/catalogo-politicas/politica/programa-nacional-de-acesso-ao-ensino-tecnico-e-emprego-pronatec-br/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "uses-http2",
          "redirects-http",
          "is-on-https",
          "uses-long-cache-ttl",
          "csp-xss",
          "errors-in-console"
        ]
      },
      "startServerCommand": "npx --yes http-server _serve -p 8090 -s",
      "startServerReadyPattern": "Available on"
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.85
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
