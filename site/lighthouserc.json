{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "url": [
        "http://localhost/catalogo-politicas/",
        "http://localhost/catalogo-politicas/buscar/",
        "http://localhost/catalogo-politicas/sobre/",
        "http://localhost/catalogo-politicas/sobre/privacidade/"
      ],
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2", "redirects-http"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}